APP_NAME=QFS
SWAPS_ENABLED=false
CHANGELLY_API_KEY=
CHANGELLY_PRIVATE_KEY_PATH=
SWAP_TREASURY_URL=
SWAP_TREASURY_TOKEN=
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://q-arculuspro.live

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
# cPanel: Email Accounts -> Connect Devices -> Outgoing Server (SSL/TLS).
# SMTP is enabled. Fill the outgoing server and mailbox credentials below.
MAIL_HOST=
MAIL_PORT=465
MAIL_TIMEOUT=15
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@q-arculuspro.live"
MAIL_FROM_NAME="${APP_NAME}"

# Account recovery needs a real delivery mailer, such as smtp, and a verified sender.
# Log/array transports and fallback paths to them are disabled for real recovery links.
# Recovery links use QFS_PUBLIC_URL below; use the user-facing HTTPS origin.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
QFS_SESSION_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qfs
DB_USERNAME=qfs
DB_PASSWORD=
DB_COLLATION=utf8mb4_bin
QFS_PUBLIC_URL=https://q-arculuspro.live
QFS_SUPPORT_EMAIL=support@q-arculuspro.live
QFS_ACCOUNT_EMAILS=true
QFS_ILLUSTRATIVE_REVIEWS=false
COINGECKO_DEMO_API_KEY=
QFS_ALLOWED_ORIGINS=https://q-arculuspro.live,https://www.q-arculuspro.live
CRON_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
QFS_DEV_LOGIN=false
QFS_DEV_LOGIN_EMAIL=
QFS_DEV_LOGIN_PASSWORD=
