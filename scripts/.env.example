APP_NAME=QFS
SWAPS_ENABLED=true
CHANGELLY_API_KEY=
CHANGELLY_PRIVATE_KEY_PATH=
SWAP_TREASURY_URL=
SWAP_TREASURY_TOKEN=
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://q-arculuspro.live

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses a SQLite file; an omitted DB_DATABASE uses database/database.sqlite.
DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=10000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=FULL
# PHP 8.4+ uses this mode; PHP 8.2/8.3 use native deferred transactions with conflict retries.
DB_TRANSACTION_MODE=IMMEDIATE

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
# cPanel: Email Accounts -> Connect Devices -> Outgoing Server (SSL/TLS).
# SMTP is enabled. Fill the outgoing server and mailbox credentials below.
MAIL_HOST=
MAIL_PORT=465
MAIL_TIMEOUT=15
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@q-arculuspro.live"
MAIL_FROM_NAME="${APP_NAME}"

# Account recovery and notification email require SMTP (or MAIL_URL). Forgot password
# returns "temporarily unavailable" until host + mailbox credentials are set here or in
# Admin → Settings → Email & SMTP. Log/array mailers cannot send recovery links.
# Recovery links use QFS_PUBLIC_URL (HTTPS in production). Local dev: Mailpit on
# 127.0.0.1:1025 with empty MAIL_USERNAME/MAIL_PASSWORD works when APP_ENV=local.
# Production queue: set QUEUE_CONNECTION=database and run queue:work database --queue=mail
# (with QUEUE_CONNECTION=sync, notification emails send inline during the request).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
QFS_SESSION_SECRET=
# Sign users out after this many minutes without activity (dashboard/admin). 0 = disabled.
QFS_SESSION_IDLE_MINUTES=30
QFS_CRYPTO_WITHDRAWALS=true
QFS_PUBLIC_URL=https://q-arculuspro.live
QFS_SUPPORT_EMAIL=support@q-arculuspro.live
QFS_ACCOUNT_EMAILS=true
# Enable only for an explicitly disclosed class-project sample review display.
QFS_ILLUSTRATIVE_REVIEWS=false
COINGECKO_DEMO_API_KEY=
QFS_ALLOWED_ORIGINS=https://q-arculuspro.live,https://www.q-arculuspro.live
CRON_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Local: ADMIN_* syncs password on boot. Deposit/mail env vars copy into Setting when DB values are empty.
QFS_ENV_OVERRIDES_DB=false
DEPOSIT_BANK_NAME=
DEPOSIT_BANK_ACCOUNT=
DEPOSIT_BANK_ACCOUNT_NAME=
DEPOSIT_BTC_ADDRESS=
DEPOSIT_ETH_ADDRESS=
DEPOSIT_USDT_TRC20=
DEPOSIT_USDT_BEP20=
QFS_DEV_LOGIN=false
QFS_DEV_LOGIN_EMAIL=
QFS_DEV_LOGIN_PASSWORD=

# cPanel: switch to mysql, then provide the host's database values.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cpanel_database
# DB_USERNAME=cpanel_user
# DB_PASSWORD=
# DB_COLLATION=utf8mb4_bin
