# ============================================================
# QFS — environment template
# Copy to `.env` and fill in real values, or set these in the
# Netlify UI under Site settings → Environment variables.
# ============================================================

# ---- Database (PostgreSQL) ----
# Required. Hosted Postgres — Neon, Supabase, RDS, etc.
# A local `file:./dev.db` will NOT work on Netlify: serverless functions have an
# ephemeral filesystem, so all users/balances/sessions would vanish between
# requests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public"

# Laravel API origin. Next proxies every non-wallet /api request here.
# The URL must be reachable by the Next server, not necessarily by the browser.
LARAVEL_API_URL="http://127.0.0.1:8000"

# Unpooled connection used for migrations. Hosted providers give you a separate
# "direct" URL because a pooled connection (pgBouncer) cannot run DDL.
# If your provider gives you only one URL, set this to the same value.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public"

# ---- Secrets ----
# Keys the session-token HMAC. MUST be at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production refuses to serve requests if this is missing or too short.
SESSION_SECRET="change-me-to-a-long-random-string"

# Secret that must be sent as the `x-cron-secret` header when POSTing to
# /api/cron/accrue. On Netlify the scheduled `accrue` function calls the same
# service directly and does not need this, but keep it set so the HTTP endpoint
# stays available for manual runs.
CRON_SECRET="generate-a-random-string"

# ---- App ----
# Used in the wallet sign-in challenge and referral links. Must match the public
# origin exactly, or the address you show a user will not match the site they are
# on. No trailing slash.
NEXT_PUBLIC_APP_URL="https://q-arculuspro.live"
NEXT_PUBLIC_SUPPORT_EMAIL="support@q-arculuspro.live"

# Admin account created by `npm run db:seed` (optional; defaults to
# admin@qfs.local / Admin1234! if absent — change it for any real deployment).
ADMIN_EMAIL="admin@qfs.local"
ADMIN_PASSWORD="change-this-strong-password"

# ---- Tests (local only, never on Netlify) ----
# `npm test` needs a throwaway Postgres database it can drop and recreate.
# It must be a SEPARATE database from DATABASE_URL — the suite runs
# `prisma db push --force-reset`, which wipes the target.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/qfs_test?schema=public"
# TEST_DIRECT_URL="postgresql://USER:PASSWORD@HOST/qfs_test?schema=public"
